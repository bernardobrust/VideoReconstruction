version(2);

project_name = "VideoReconstruction";

patterns = {
    "*.c",
    "*.cpp",
    "*.h",
    "*.m",
    "*.bat",
    "*.sh",
    "*.4coder",
};

blacklist_patterns = {
    ".*",
};

load_paths_base = {
    { ".", .relative = true, .recursive = true, .exclude = { ".git", "build", "bin", "lib", "dbg", "profiling" } },
};

load_paths = {
    .win = load_paths_base,
    .linux = load_paths_base,
    .mac = load_paths_base,
};

commands = {
    .build = {
        .out = "*compilation*",
        .footer_panel = true,
        .save_dirty_files = true,

        .win = "cmd /c build.bat",
        .linux = "./build.sh",
        .mac = "./build.sh",
    },

    .run_jellyfin = {
        .out = "*run_jellyfin*",
        .footer_panel = true,
        .save_dirty_files = false,

        .win = "build\\inspector_debug_windows.exe test_files\\1080_jellyfin.mp4",
        .linux = "build/inspector_debug_windows test_files/1080_jellyfin.mp4",
        .mac = "build/inspector_debug_windows test_files/1080_jellyfin.mp4",
    },
};

fkey_command = {
    .F1 = "build",
    .F2 = "run_jellyfin",
};